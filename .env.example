# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Required for every API route except /health. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SPA_API_KEY=

# Optional overrides (defaults shown)
# SPA_DATABASE_URL=sqlite:///data/spa.db
# SPA_SCRATCH_ROOT=scratch
# SPA_LOG_LEVEL=INFO
# SPA_SCANNER_TIMEOUT_SECONDS=300
# SPA_CLONE_TIMEOUT_SECONDS=120
# SPA_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# Scanner binaries. Leave unset to use .tools/<name>/ (scripts/install_scanners.py)
# or PATH. Gitleaks is a standalone binary, e.g. installed with winget.
# SPA_SEMGREP_BIN=
# SPA_BANDIT_BIN=
# SPA_PIP_AUDIT_BIN=
# SPA_GITLEAKS_BIN=
