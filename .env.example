# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Required for every API route except /health. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SPA_API_KEY=

# Optional overrides (defaults shown)
# SPA_DATABASE_URL=sqlite:///data/spa.db
# SPA_SCRATCH_ROOT=scratch
# SPA_LOG_LEVEL=INFO
# SPA_SCANNER_TIMEOUT_SECONDS=300
# SPA_CLONE_TIMEOUT_SECONDS=120
# SPA_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# Scanner binaries. Leave unset to use .tools/<name>/ (scripts/install_scanners.py)
# or PATH. Gitleaks is a standalone binary, e.g. installed with winget.
# SPA_SEMGREP_BIN=
# SPA_BANDIT_BIN=
# SPA_PIP_AUDIT_BIN=
# SPA_GITLEAKS_BIN=

# AI layer. Developer mode needs no model: prompts are built from templates and
# handed to your own coding assistant. Lab mode (experiments) uses a local
# Ollama server, which must be on this machine (loopback only).
# SPA_LLM_PROVIDER=template
# SPA_OLLAMA_URL=http://127.0.0.1:11434
# SPA_OLLAMA_MODEL=qwen2.5-coder:7b-instruct
# SPA_LLM_TIMEOUT_SECONDS=180
# SPA_CONTEXT_RADIUS=10
# SPA_MAX_CONTEXT_LINES=40
# SPA_PROMPT_TOKEN_BUDGET=1500

# Lab mode, verification gate 3b: the separate interpreter that runs a fixture's
# behaviour tests against a patched scratch copy (scripts/install_fixture_env.py).
# SPA_FIXTURE_PYTHON=
# SPA_FIXTURE_TEST_TIMEOUT_SECONDS=60
